{
  "name": "escritorio-ia",
  "version": "0.1.0",
  "private": true,
  "description": "Escritório pixel art que mostra seus agentes do Claude Code trabalhando em tempo real",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "install-hooks": "node scripts/install-hooks.mjs",
    "uninstall-hooks": "node scripts/install-hooks.mjs --remove",
    "install-agents": "node scripts/install-agents.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
