		{"id":"revisor","type":"text","text":"### [[revisor]]\nRevisa a qualidade antes de entregar.\nSó leitura + Bash","x":400,"y":-200,"width":320,"height":140,"color":"4"},
		{"id":"documentador","type":"text","text":"### [[documentador]]\nEscreve a documentação e atualiza a memória.","x":400,"y":20,"width":320,"height":140,"color":"4"},
